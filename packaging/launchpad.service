[Unit]
Description=Launchpad Home (records, Home Git, vault and GitHub cache; agents run on runners)
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/launchpad daemon
Restart=on-failure
RestartSec=2
# Home runs no agents: a machine that runs them installs a runner (Home's install-runner.sh or launchpad connect).
KillMode=control-group
TimeoutStopSec=10
Environment=RUST_LOG=info

[Install]
WantedBy=default.target
