# syntax=docker/dockerfile:1.7
# Home Space image from a published GitHub release: no Rust or UI build on the
# Space builder. To update, change LAUNCHPAD_RELEASE to a newer tag (the Space
# rebuilds on save). The binary and the deploy files both come from that tag.
ARG LAUNCHPAD_RELEASE=v2026.11.06.1

FROM debian:bookworm-slim AS release
ARG LAUNCHPAD_RELEASE
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
WORKDIR /release
RUN set -eu; base="https://github.com/Wauplin/launchpad/releases/download/${LAUNCHPAD_RELEASE}"; \
    curl -fsSLO "$base/launchpad-linux-x86_64.tar.gz"; curl -fsSLO "$base/launchpad-linux-x86_64.tar.gz.sha256"; \
    sha256sum -c launchpad-linux-x86_64.tar.gz.sha256; \
    mkdir pkg && tar xzf launchpad-linux-x86_64.tar.gz -C pkg; \
    install -m 0755 pkg/target/release/launchpad /launchpad; commit="$(cat pkg/COMMIT)"; \
    mkdir /src && curl -fsSL "https://codeload.github.com/Wauplin/launchpad/tar.gz/${commit}" | tar xz -C /src --strip-components=1; \
    /launchpad help >/dev/null

FROM node:24.14.1-bookworm-slim
COPY --from=release /launchpad /usr/local/bin/launchpad
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv git openssh-client ca-certificates curl tini && rm -rf /var/lib/apt/lists/*
COPY --from=release /src/deploy/hf-space/release.json /opt/space/release.json
COPY --from=release /src/deploy/hf-space/supervisor/install_tools.py /opt/space/install_tools.py
RUN --mount=type=cache,target=/root/.npm python3 /opt/space/install_tools.py
RUN git config --system credential.https://github.com.helper '!gh auth git-credential'
COPY --from=release /src/deploy/hf-space/requirements.txt /opt/home/requirements.txt
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -r /opt/home/requirements.txt && ln -s /opt/venv/bin/hf /usr/local/bin/hf && ln -s /opt/venv/bin/uv /usr/local/bin/uv
RUN userdel node && useradd --uid 1000 --create-home --shell /bin/bash user
# A Burst runner adds its own CA to the system store, so its agents trust the runner proxy (launchpad_core::netcap).
RUN chown user /etc/ssl/certs/ca-certificates.crt
COPY --from=release /src/deploy/hf-space/gateway/__init__.py /src/deploy/hf-space/gateway/proxy.py /opt/home/gateway/
COPY --from=release /src/deploy/hf-home/main.py /src/deploy/hf-home/onboarding.py /src/deploy/hf-home/setup.html /src/deploy/hf-home/install-runner.sh /opt/home/
ENV PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/home/user
WORKDIR /opt/home
USER user
RUN claude --version && codex --version && opencode --version && gh --version && hf version
EXPOSE 7860
ENTRYPOINT ["/usr/bin/tini", "--", "python", "main.py"]
