# syntax=docker/dockerfile:1.7
FROM node:24.14.1-bookworm-slim@sha256:b506e7321f176aae77317f99d67a24b272c1f09f1d10f1761f2773447d8da26c AS web
WORKDIR /src/web
COPY web/package.json web/pnpm-lock.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile
COPY web/ ./
RUN pnpm build

FROM rust:1.93.1-bookworm@sha256:7c4ae649a84014c467d79319bbf17ce2632ae8b8be123ac2fb2ea5be46823f31 AS build
RUN apt-get update && apt-get install -y --no-install-recommends cmake clang && rm -rf /var/lib/apt/lists/*
WORKDIR /src
ARG LAUNCHPAD_REVISION=source-build
ENV LAUNCHPAD_BUILD_COMMIT=${LAUNCHPAD_REVISION}
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY skills ./skills
COPY desktop/src-tauri ./desktop/src-tauri
COPY --from=web /src/web/dist ./web/dist
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/src/target cargo build --locked --release -p launchpad && cp target/release/launchpad /launchpad && cargo metadata --locked --format-version=1 > /rust-dependencies.json

FROM node:24.14.1-bookworm-slim@sha256:b506e7321f176aae77317f99d67a24b272c1f09f1d10f1761f2773447d8da26c AS runtime
ARG LAUNCHPAD_REVISION=source-build
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv libdbus-1-3 git openssh-client ripgrep ca-certificates curl tini build-essential && rm -rf /var/lib/apt/lists/*
RUN npm install -g @openai/codex@0.166.0 @anthropic-ai/claude-code@2.1.311 opencode-ai@1.18.35
ARG GH_VERSION=2.100.0
RUN curl -fsSL https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz -o /tmp/gh_${GH_VERSION}_linux_amd64.tar.gz && curl -fsSL https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_checksums.txt -o /tmp/gh-checksums && cd /tmp && sha256sum --ignore-missing -c gh-checksums && tar xzf gh_${GH_VERSION}_linux_amd64.tar.gz --strip-components=2 -C /usr/local/bin gh_${GH_VERSION}_linux_amd64/bin/gh && rm gh_${GH_VERSION}_linux_amd64.tar.gz gh-checksums
RUN userdel node && useradd --uid 1000 --create-home --home-dir /home/agent --shell /bin/bash agent
COPY deploy/hf-space/requirements.txt /opt/space/requirements.txt
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -r /opt/space/requirements.txt && ln -s /opt/venv/bin/hf /usr/local/bin/hf
COPY --from=build /launchpad /usr/local/bin/launchpad
COPY --from=build /rust-dependencies.json /opt/space/sbom/rust.json
COPY deploy/hf-space/ /opt/space/
COPY skills /src/skills
ENV PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/space
RUN python -c "import json; from pathlib import Path; p=Path('release.json'); d=json.loads(p.read_text()); d['launchpad']='${LAUNCHPAD_REVISION}'; p.write_text(json.dumps(d))"
# Classify exactly the database schema generated by this binary, without network or credentials.
RUN python -m supervisor.build_schema && python -m pip list --format=json > /opt/space/sbom/python.json && npm list -g --json > /opt/space/sbom/node.json && dpkg-query -W > /opt/space/sbom/debian.txt
EXPOSE 7860
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s CMD python -m supervisor.health
ENTRYPOINT ["/usr/bin/tini","--","python","-m","supervisor.main"]
