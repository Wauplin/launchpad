{
  "name": "launchpad-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test:sessions": "node --experimental-strip-types --test tests/sessionStore.test.mjs",
    "test:composer": "node --experimental-strip-types --test tests/composer.test.mjs",
    "test:operations": "node --experimental-strip-types --test tests/operations.test.mjs",
    "test:attachments": "node --experimental-strip-types --test tests/attachments.test.mjs",
    "test:terminals": "node --experimental-strip-types --test tests/terminals.test.mjs",
    "test:code": "node --experimental-strip-types --test tests/codeSafety.test.mjs",
    "test:markdown": "node --experimental-strip-types --test tests/commitLinks.test.mjs tests/fileCitations.test.mjs",
    "test:proposals": "node --experimental-strip-types --test tests/proposals.test.mjs",
    "test:drafts": "node --experimental-strip-types --test tests/draftPersistence.test.mjs",
    "test:tour": "node --test tests/tour.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-virtual": "^3.14.13",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "^3.4.16",
    "github-markdown-css": "^5.9.0",
    "markdown-it": "^15.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/headless": "6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "pnpm": {
    "overrides": {
      "source-map-js": "^1.2.2"
    }
  }
}
